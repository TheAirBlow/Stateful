<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Title>TheAirBlow.Stateful</Title>
        <Authors>TheAirBlow</Authors>
        <Description>Spices up Telegram bot development</Description>
        <Copyright>Copyright © TheAirBlow 2026</Copyright>
        <PackageProjectUrl>https://github.com/TheAirBlow/Stateful</PackageProjectUrl>
        <PackageLicenseUrl>https://github.com/TheAirBlow/Stateful/blob/main/LICENSE</PackageLicenseUrl>
        <RepositoryUrl>https://github.com/TheAirBlow/Stateful.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Version>3.2.0</Version>
        <LangVersion>default</LangVersion>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <DocumentationFile>bin\Release\net8.0\TheAirBlow.Stateful.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
        <PackageReference Include="Telegram.Bot" Version="22.10.3.2" GeneratePathProperty="true" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="$(PkgTelegram_Bot)\lib\**\Telegram.Bot.xml" />
        <ProjectReference Include="..\TheAirBlow.Stateful.Generators\TheAirBlow.Stateful.Generators.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>
</Project>
